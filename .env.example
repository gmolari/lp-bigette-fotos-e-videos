# ─────────────────────────────────────────────────────────
#  Copie para .env.local e preencha.
#
#  As três primeiras NÃO são segredo — aparecem na página. Elas moram
#  aqui porque o repositório é público e esses dados são da cliente:
#  fora do código, não entram no histórico do git nem na busca de
#  código do GitHub. Precisam existir no ambiente de PRODUÇÃO também.
# ─────────────────────────────────────────────────────────

# Domínio final. Usado no canonical, sitemap, robots.txt e nos dados
# estruturados. COM https:// na frente — sem protocolo o build quebra em
# `Failed to collect page data`, longe daqui e sem dizer que foi esta
# variável. (O código conserta espaço, barra no fim e protocolo ausente,
# mas escreva certo mesmo assim.)
#
# Pode deixar em branco na Vercel: sem ela, o build usa a
# VERCEL_PROJECT_PRODUCTION_URL, que a própria Vercel expõe.
NEXT_PUBLIC_SITE_URL=https://bigettefotosevideos.com.br

# ---- Contato da cliente (OBRIGATÓRIO em produção) ----
# WhatsApp com DDI+DDD. Pode colar com parênteses, espaço e traço —
# o código fica só com os dígitos.
# ⚠️ SEM ISTO OS 11 CTAs DA PÁGINA ABREM CONVERSA COM NÚMERO INVÁLIDO.
NEXT_PUBLIC_WHATSAPP=

# Instagram. Pode colar "@handle", "handle" ou a URL do perfil.
NEXT_PUBLIC_INSTAGRAM=

# E-mail. Opcional: em branco, é OMITIDO dos dados estruturados, que é
# melhor que publicar um endereço que não existe.
NEXT_PUBLIC_EMAIL=

# ---- Analytics (opcional) ----
# Se ficarem vazios, NENHUM script de terceiro é carregado.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# ---- Verificação de propriedade (opcional) ----
# Google Search Console → método "tag HTML" → cole só o content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
