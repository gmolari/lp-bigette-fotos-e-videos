# ─────────────────────────────────────────────────────────
#  Copie para .env.local e preencha.
#  Só NEXT_PUBLIC_SITE_URL é obrigatório.
# ─────────────────────────────────────────────────────────

# Domínio final, SEM barra no fim. Usado no canonical, sitemap,
# robots.txt e nos dados estruturados.
NEXT_PUBLIC_SITE_URL=https://bigette.com.br

# ---- Analytics (opcional) ----
# Se ficarem vazios, NENHUM script de terceiro é carregado.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# ---- Verificação de propriedade (opcional) ----
# Google Search Console → método "tag HTML" → cole só o content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
